# Database Configuration
MONGODB_URI=mongodb://localhost:27017/apartment-management
DATABASE_NAME=manivaasam

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SENDER_EMAIL=noreply@apartmentmanagement.com
SENDER_NAME=Apartment Management

# API Configuration
API_BASE_URL=http://localhost:5001/api
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=debug

# Encryption
ENCRYPTION_KEY=your_encryption_key_here_32_chars
